# Secrets des fonctions Supabase (à envoyer avec : supabase secrets set --env-file supabase/functions/.env)
# Ne jamais mettre ces valeurs dans le .env du site : elles doivent rester côté serveur.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=http://localhost:5173

# Notifications par e-mail des candidatures reçues par le formulaire (facultatif) : clé API Resend
# (resend.com) et expéditeur d'un domaine vérifié chez Resend. Sans elles, aucun e-mail n'est envoyé.
RESEND_API_KEY=re_...
EMAIL_EXPEDITEUR=Filtre <notifications@votre-domaine.fr>
