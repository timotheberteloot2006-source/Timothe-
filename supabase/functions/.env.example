# Secrets des fonctions Supabase (à envoyer avec : supabase secrets set --env-file supabase/functions/.env)
# Ne jamais mettre ces valeurs dans le .env du site : elles doivent rester côté serveur.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
SITE_URL=http://localhost:5173

# Notifications par e-mail des candidatures reçues par le formulaire (facultatif) : clé API Resend
# (resend.com) et expéditeur d'un domaine vérifié chez Resend. Sans elles, aucun e-mail n'est envoyé.
RESEND_API_KEY=re_...
EMAIL_EXPEDITEUR=Filtre <notifications@votre-domaine.fr>

# Rappels d'entretien de la veille (facultatif, avec les e-mails ci-dessus) : secret attendu par
# la fonction rappels-entretiens, appelée chaque jour par la tâche planifiée (npm run
# planifier:rappels). 24 caractères au moins : lettres, chiffres, - et _.
RAPPELS_SECRET=...
# Fuseau horaire des heures indiquées dans les rappels
FUSEAU_HORAIRE=Europe/Paris
